# Required
H3_API_KEY=change-me-to-a-strong-random-key

# Optional: clip length & memory tuning
H3_MAX_DURATION=30.0
H3_FFN_CHUNK=16384
H3_ATTN_CHUNK=32768
H3_PARTITION=both
# H3_VRAM_FRACTION=0

# Optional: prompt polish & auto-titler LLM (OpenAI-compatible)
# H3_LLM_URL=http://host.docker.internal:8001
# H3_LLM_MODEL=qwen3.8-neo-coder
# H3_LLM_KEY=

# Optional: Vision-Language Model for Series last-frame continuity (OpenAI-compatible)
# H3_VLM_URL=http://100.68.194.66:8000
# H3_VLM_MODEL=qwen3.8-27b
# H3_VLM_KEY=

# Host paths for launch scripts
MODEL_DIR=/data/stage/minimax-h3
OUT_DIR=/data/stage/h3-out
HFCACHE_DIR=./hfcache
BIND_HOST=0.0.0.0
